local BLOCK = { "gamepass", "robux", "purchase", "product", "donate", "vip", "shop", "store", "gift", "buy pass" }
local function blockedName(s)
	s = string.lower(tostring(s or ""))
	for _, b in ipairs(BLOCK) do
		if string.find(s, b, 1, true) then return true end
	end
	return false
end

local function rarityFromText(text)
	text = string.lower(tostring(text or ""))
	local order = { "spooky", "omega", "limited", "secret", "mythic", "legendary", "epic", "rare", "uncommon", "common" }
	local map = {
		spooky = "Spooky", omega = "Omega", limited = "Limited", secret = "Secret",
		mythic = "Mythic", legendary = "Legendary", epic = "Epic", rare = "Rare",
		uncommon = "Uncommon", common = "Common",
	}
	for _, k in ipairs(order) do
		if string.find(text, k, 1, true) then return map[k] end
	end
	return nil
end

local function rarityAllowed(r)
	if not r then return true end -- unknown = allow (was blocking everything before)
	return F.Rarity[r] == true
end

-- find a BasePart that represents the cage
local function getCagePart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		if inst.PrimaryPart then return inst.PrimaryPart end
		return inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- collect candidate cages from workspace
local function findCages()
	local list = {}
	local h = hrp()
	if not h then return list end
	for _, obj in ipairs(S.WS:GetDescendants()) do
		local name = obj.Name
		local lname = string.lower(name)
		if (string.find(lname, "cage", 1, true) or string.find(lname, "crate", 1, true))
			and not blockedName(name)
			and (obj:IsA("Model") or obj:IsA("BasePart")) then
			local part = getCagePart(obj)
			if part and part:IsA("BasePart") then
				local dist = (part.Position - h.Position).Magnitude
				if dist <= (F.StealDist or 250) then
					local r = rarityFromText(name)
					-- also check attributes / children text
					if not r then
						for _, d in ipairs(obj:GetDescendants()) do
							if d:IsA("TextLabel") or d:IsA("TextButton") then
								r = rarityFromText(d.Text)
								if r then break end
							end
						end
					end
					if rarityAllowed(r) then
						table.insert(list, { inst = obj, part = part, dist = dist, rarity = r or "Unknown" })
					end
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function findPromptNear(part)
	if not part then return nil end
	-- prompt on part or nearby siblings/parent
	local p = part:FindFirstChildWhichIsA("ProximityPrompt", true)
	if p then return p end
	if part.Parent then
		p = part.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
		if p then return p end
	end
	-- nearby prompts
	for _, obj in ipairs(S.WS:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Parent then
			local pp = obj.Parent
			if pp:IsA("BasePart") and (pp.Position - part.Position).Magnitude < 12 then
				if not blockedName(obj.ActionText) and not blockedName(obj.Name) then
					return obj
				end
			end
		end
	end
	return nil
end

local function tweenTo(pos)
	local h = hrp()
	if not h then return end
	local goal = CFrame.new(pos + Vector3.new(0, 3, 0))
	local dist = (h.Position - pos).Magnitude
	local t = math.clamp(dist / 80, 0.15, 1.6)
	local tw = S.TS:Create(h, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = goal })
	tw:Play()
	tw.Completed:Wait()
end

local function findBasePart()
	local h = hrp()
	if not h then return nil end
	local best, bestD
	for _, obj in ipairs(S.WS:GetDescendants()) do
		if obj:IsA("BasePart") then
			local n = string.lower(obj.Name)
			if n:find("barn") or n:find("base") or n:find("plot") or n:find("home") or n:find("spawn") then
				local d = (obj.Position - h.Position).Magnitude
				if not bestD or d < bestD then
					bestD = d
					best = obj
				end
			end
		end
	end
	return best
end

-- AUTO STEAL LOOP (the part that actually works)
local stealBusy = false
local function runStealOnce()
	if stealBusy then return end
	stealBusy = true
	local ok, err = pcall(function()
		local cages = findCages()
		if #cages == 0 then return end
		local target = cages[1]
		local part = target.part
		if not part or not part.Parent then return end

		-- go to cage
		tweenTo(part.Position)
		task.wait(0.08)

		local prompt = findPromptNear(part)
		if prompt then
			-- force usable
			pcall(function()
				prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 20)
				prompt.RequiresLineOfSight = false
			end)
			for _ = 1, 4 do
				fireP(prompt)
				task.wait(0.12)
			end
		else
			-- click detector fallback
			local cd = part:FindFirstChildWhichIsA("ClickDetector", true)
			if not cd and part.Parent then
				cd = part.Parent:FindFirstChildWhichIsA("ClickDetector", true)
			end
			if cd and fireclickdetector then
				pcall(fireclickdetector, cd)
			end
		end

		task.wait(0.25)

		-- return home so boss chase doesn't waste the steal
		if F.ReturnHome then
			local base = findBasePart()
			if base then
				tweenTo(base.Position)
			end
		end
	end)
	if not ok then warn("[ShoField] steal err", err) end
	stealBusy = false
end

