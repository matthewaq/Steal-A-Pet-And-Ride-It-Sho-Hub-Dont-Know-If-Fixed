	task.spawn(function()
		while F.SpeedLoop do
			if Hum and Hum.Parent then Hum.WalkSpeed = F.WalkSpeed end
			task.wait(0.2)
		end
	end)
end)
tog(SpeedP, "Infinite Jump", "InfJump", function(on)
	if on then
		Conns.InfJump = S.UIS.JumpRequest:Connect(function()
			if F.InfJump and Hum and Hum.Parent then
				Hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	elseif Conns.InfJump then
		Conns.InfJump:Disconnect() Conns.InfJump = nil
	end
end)
tog(SpeedP, "Noclip", "Noclip", function(on)
	if on then
		Conns.Noclip = S.RS.Stepped:Connect(function()
			if F.Noclip and Char then
				for _, p in ipairs(Char:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
			end
		end)
	elseif Conns.Noclip then
		Conns.Noclip:Disconnect() Conns.Noclip = nil
	end
end)

